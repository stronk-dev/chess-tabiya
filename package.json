{
  "name": "chess-tabiya",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "schema:check": "node tools/verify-scaffold.mjs",
    "test": "vitest run",
    "test:maia": "vitest run --config vitest.maia.config.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm typecheck && pnpm test && pnpm schema:check"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "fast-check": "4.9.0",
    "svelte": "5.56.8",
    "tsx": "4.23.12",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0"
}
