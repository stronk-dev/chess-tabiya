    { "file": "apps/server/src/rest.ts", "symbol": "createRestHandler:human-split", "call": "selector.select", "operation": "run.human_split" },
    { "file": "apps/server/src/rest.ts", "symbol": "createRestHandler:corpus", "call": "corpusSource.stats", "operation": "run.corpus" },
    { "file": "apps/server/src/rest.ts", "symbol": "createRestHandler:reasoning-review", "call": "reasoningReviewProvider.review", "operation": "run.reasoning_review" },
    { "file": "apps/server/src/rest.ts", "symbol": "createRestHandler:speech", "call": "ttsProvider.synthesize", "operation": "run.speech" },
    { "file": "apps/server/src/rest.ts", "symbol": "createRestHandler:prediction", "call": "selector.select", "operation": "run.prediction" },
    { "file": "apps/server/src/guidance.ts", "symbol": "renderVoice", "call": "provider.render", "operation": "run.voice" },
    { "file": "apps/server/src/service.ts", "symbol": "RunService.createGroup:human_replies", "call": "selector.select", "operation": "run.group.human_replies" },
    { "file": "apps/server/src/service.ts", "symbol": "RunService.createGroup:engine_top_n", "call": "selector.enumerate", "operation": "run.group.engine_top_n" },
    { "file": "apps/server/src/service.ts", "symbol": "RunService.groupReply", "call": "selector.select", "operation": "run.group_reply" },
    { "file": "apps/server/src/service.ts", "symbol": "RunService.branchDecidedness", "call": "#tablebase.probe", "operation": "run.branch_decidedness" }
  ],
  "runCreationSites": [
    { "file": "apps/server/src/rest.ts", "symbol": "createRestHandler:/runs", "call": "service.create", "operations": ["run.create.pack", "run.create.position"] },
    { "file": "apps/server/src/rest.ts", "symbol": "createRestHandler:pack-playtest", "call": "service.create", "operations": ["run.create.playtest"] },
    { "file": "apps/server/src/service.ts", "symbol": "RunService.create", "call": "createRun", "operations": ["run.create.pack", "run.create.position"] },
    { "file": "apps/server/src/service.ts", "symbol": "RunService.createRatedGame", "call": "createRun", "operations": ["run.create.rated"] },
    { "file": "apps/server/src/service.ts", "symbol": "RunService.importGame", "call": "createRun", "operations": ["run.create.imported"] },
    { "file": "apps/server/src/service.ts", "symbol": "RunService.flip", "call": "createRun", "operations": ["run.create.flip"] },
    { "file": "apps/server/src/service.ts", "symbol": "RunService.createRepertoireGapRun", "call": "createRun", "operations": ["run.create.repertoire_gap"] },
    { "file": "apps/server/src/service.ts", "symbol": "RunService.duplicate", "call": "this.create", "operations": ["run.create.duplicate_pack", "run.create.duplicate_position"] }
  ]
