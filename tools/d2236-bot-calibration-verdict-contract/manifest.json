      "requiredForHumanDistribution": true
    },
    {
      "id": "candidate_loss_tail",
      "scope": "all-three-windows",
      "statistic": "simultaneous-max-standardized-rate-difference",
      "thresholdsCp": [50, 100, 150, 250],
      "mateLossArm": true,
      "referenceLimit": "q95 of 999 deterministic target-human split max-statistic replicates",
      "test": "q95 bot-vs-target max-statistic <= referenceLimit",
      "requiredForHumanDistribution": true
    },
    {
      "id": "opening_band_identity",
      "scope": "exact-fen-opening-only",
      "statistic": "mean-negative-log-probability-of-observed-human-move",
      "population": "128 canonical exact FENs, each with >=100 observed moves in every band",
      "referenceLimit": "999 deterministic game-clustered bootstrap replicates over the frozen exact-FEN population",
      "test": "target band is unique minimum and Holm-adjusted q05 target-vs-runner-up margin > 0",
      "requiredForHumanDistribution": false,
      "requiredForBandIdentity": true
    }
  ],
  "multiplicity": {
    "method": "holm-bonferroni",
    "familyWiseAlpha": 0.05,
    "family": "every claimed profile x every required metric; no metric may be dropped after results"
  },
  "verdicts": {
    "strength": ["calibrated_relative", "unresolved", "invalid"],
    "distribution": ["human_reference_equivalent", "controlled_divergence", "rejected", "insufficient"],
    "bandIdentity": ["supported", "refuted", "insufficient"],
    "humanLikeLabelRequires": {
      "strength": "calibrated_relative",
      "distribution": "human_reference_equivalent",
      "bandIdentity": "supported"
    },
    "controlledDivergence": {
