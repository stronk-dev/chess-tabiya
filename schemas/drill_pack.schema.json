{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chess-tabiya:schema:drill-pack:0.14",
  "title": "Tabiya Drill Pack",
  "description": "Living v0.14 format for an engine-independent authored drill.",
  "type": "object",
  "required": [
    "id",
    "version",
    "title",
    "mode",
    "start",
    "objective",
    "checkpoints",
    "opponentPolicy",
    "feedbackPolicy",
    "provenance"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/semver" },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "mode": { "enum": ["line", "plan", "outcome", "trajectory"] },
    "phase": {
      "enum": ["opening", "middlegame", "endgame", "cross_phase"]
    },
    "difficulty": { "$ref": "#/$defs/difficulty" },
    "start": { "$ref": "#/$defs/start" },
    "objective": { "$ref": "#/$defs/objective" },
    "concepts": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "shapes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "planClasses": {
      "type": "array",
      "items": { "$ref": "#/$defs/planClass" }
    },
    "spine": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/spineNode" }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/checkpoint" }
    },
    "opponentPolicy": { "$ref": "#/$defs/opponentPolicy" },
    "feedbackPolicy": {
      "enum": ["delayed_checkpoint", "segment_end", "immediate_guard"]
    },
    "guard": {
      "type": "object",
      "properties": {
        "evalSwingCp": {
          "oneOf": [
            { "type": "integer", "minimum": 50, "maximum": 1000 },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "authoredBoundary": { "$ref": "#/$defs/authoredBoundary" },
    "deviations": {
      "type": "array",
      "items": { "$ref": "#/$defs/deviation" }
    },
    "feedbackClaims": {
      "type": "array",
      "items": { "$ref": "#/$defs/feedbackClaim" }
    },
    "retryVariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {
            "enum": [
              "same_root_new_defense",
              "alternate_plan_class",
              "related_position_same_idea",
              "opposite_side",
              "different_material_details"
            ]
          },
          "note": { "$ref": "#/$defs/nonEmptyString" }
        },
        "additionalProperties": false
      }
    },
    "legs": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/trajectoryLeg" }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "square": {
      "type": "string",
      "pattern": "^[a-h][1-8]$"
    },
    "file": {
      "type": "string",
      "pattern": "^[a-h]$"
    },
    "moveUci": {
      "type": "string",
      "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
    },
    "difficulty": {
      "type": "object",
      "properties": {
        "minOnlineRapid": { "type": "integer", "minimum": 1000 },
        "maxOnlineRapid": { "type": "integer", "minimum": 1000 },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "branchLengthTarget": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        }
      },
      "additionalProperties": false
    },
    "start": {
      "type": "object",
      "required": ["fen", "side"],
      "properties": {
        "fen": { "$ref": "#/$defs/nonEmptyString" },
        "movesSan": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "side": { "enum": ["white", "black"] }
      },
      "additionalProperties": false
    },
    "objectiveType": {
      "enum": [
        "reach_structure",
        "preserve_plan_window",
        "execute_break",
        "prevent_opponent_plan",
        "transition_to_endgame",
        "win",
        "hold",
        "save",
        "resist",
        "play_until_checkpoint",
        "follow_theory",
        "run_trajectory"
      ]
    },
    "objective": {
      "type": "object",
      "required": ["type", "summary"],
      "properties": {
        "type": { "$ref": "#/$defs/objectiveType" },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "grading": { "$ref": "#/$defs/objectiveGrading" },
        "successConditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/successCondition" }
        }
      },
      "additionalProperties": false
    },
    "trajectoryLeg": {
      "type": "object",
      "required": ["id", "objective"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "entryCheckpointId": { "$ref": "#/$defs/id" },
        "objective": { "$ref": "#/$defs/objective" }
      },
      "additionalProperties": false
    },
    "objectiveGrading": {
      "type": "object",
      "required": ["assessedBy", "resolveAt"],
      "properties": {
        "assessedBy": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "note"],
              "properties": {
                "kind": { "const": "authored" },
                "note": { "type": "string", "minLength": 1, "maxLength": 400 }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "category", "pieceCount", "sourceId", "retrievedAt"],
              "properties": {
                "kind": { "const": "syzygy" },
                "category": { "enum": ["win", "loss", "draw"] },
                "pieceCount": { "type": "integer", "minimum": 2, "maximum": 7 },
                "sourceId": { "const": "syzygy" },
                "retrievedAt": { "type": "string", "format": "date-time" }
              },
              "additionalProperties": false
            }
          ]
        },
        "resolveAt": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "checkpointId"],
              "properties": {
                "kind": { "const": "checkpoint" },
                "checkpointId": { "$ref": "#/$defs/id" }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind"],
              "properties": { "kind": { "const": "terminal" } },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "conditionBase": {
      "type": "object",
      "properties": {
        "to": { "enum": ["preserved", "degraded", "failed", "achieved", "transitioned"] },
        "from": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["active", "preserved", "degraded"] }
        }
      }
    },
    "successCondition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "checkpointId"],
          "properties": {
            "kind": { "const": "reach_checkpoint" },
            "checkpointId": { "$ref": "#/$defs/id" },
            "to": { "$ref": "#/$defs/conditionBase/properties/to" },
            "from": { "$ref": "#/$defs/conditionBase/properties/from" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "result"],
          "properties": {
            "kind": { "const": "outcome" },
            "result": { "enum": ["win", "loss", "draw"] },
            "to": { "$ref": "#/$defs/conditionBase/properties/to" },
            "from": { "$ref": "#/$defs/conditionBase/properties/from" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "perspective", "comparison", "value"],
          "properties": {
            "kind": { "const": "material_balance" },
            "perspective": { "enum": ["white", "black"] },
            "comparison": { "enum": ["atLeast", "atMost", "equal"] },
            "value": { "type": "number" },
            "to": { "$ref": "#/$defs/conditionBase/properties/to" },
            "from": { "$ref": "#/$defs/conditionBase/properties/from" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "fact"],
          "properties": {
            "kind": { "const": "rules_fact" },
            "fact": { "enum": ["checkmate", "stalemate"] },
            "winner": { "enum": ["white", "black"] },
            "to": { "$ref": "#/$defs/conditionBase/properties/to" },
            "from": { "$ref": "#/$defs/conditionBase/properties/from" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "feature"],
          "properties": {
            "kind": { "const": "structural_feature" },
            "feature": { "$ref": "#/$defs/structuralExpression" },
            "to": { "$ref": "#/$defs/conditionBase/properties/to" },
            "from": { "$ref": "#/$defs/conditionBase/properties/from" }
          },
          "additionalProperties": false
        }
      ]
    },
    "planClass": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "shapePlan": {
          "type": "object",
          "required": ["shape", "plan"],
          "properties": {
            "shape": { "$ref": "#/$defs/id" },
            "plan": { "$ref": "#/$defs/id" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "spineNode": {
      "type": "object",
      "required": ["id", "moveUci", "moveSan", "children"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "moveUci": { "$ref": "#/$defs/moveUci" },
        "moveSan": { "$ref": "#/$defs/nonEmptyString" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/spineNode" }
        },
        "annotations": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      },
      "additionalProperties": false
    },
    "piece": {
      "type": "object",
      "required": ["color", "role"],
      "properties": {
        "color": { "enum": ["white", "black"] },
        "role": { "enum": ["pawn", "knight", "bishop", "rook", "queen", "king"] }
      },
      "additionalProperties": false
    },
    "fileRange": { "type": "object", "required": ["from", "to"], "properties": { "from": { "$ref": "#/$defs/file" }, "to": { "$ref": "#/$defs/file" } }, "additionalProperties": false },
    "rankRange": { "type": "object", "required": ["from", "to"], "properties": { "from": { "type": "integer", "minimum": 1, "maximum": 8 }, "to": { "type": "integer", "minimum": 1, "maximum": 8 } }, "additionalProperties": false },
    "squareRegion": { "type": "object", "required": ["files", "ranks"], "properties": { "files": { "$ref": "#/$defs/fileRange" }, "ranks": { "$ref": "#/$defs/rankRange" } }, "additionalProperties": false },
    "fileTemplateFeature": {
      "oneOf": [
        { "type": "object", "required": ["kind", "color"], "properties": { "kind": { "const": "backward_pawn" }, "color": { "enum": ["white", "black"] } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "color"], "properties": { "kind": { "const": "isolated_pawn" }, "color": { "enum": ["white", "black"] } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "color"], "properties": { "kind": { "const": "doubled_pawn" }, "color": { "enum": ["white", "black"] } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "color"], "properties": { "kind": { "const": "half_open_file" }, "color": { "enum": ["white", "black"] } }, "additionalProperties": false },
        { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "open_file" } }, "additionalProperties": false }
      ]
    },
    "squareTemplateFeature": {
      "oneOf": [
        { "type": "object", "required": ["kind", "color"], "properties": { "kind": { "const": "pawn_safe_square" }, "color": { "enum": ["white", "black"] } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "color"], "properties": { "kind": { "const": "outpost" }, "color": { "enum": ["white", "black"] } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "color"], "properties": { "kind": { "const": "passed_pawn" }, "color": { "enum": ["white", "black"] } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "color", "comparison", "count"], "properties": { "kind": { "const": "direct_attack_count" }, "color": { "enum": ["white", "black"] }, "comparison": { "enum": ["atLeast", "atMost", "equal"] }, "count": { "type": "integer" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "piece"], "properties": { "kind": { "const": "piece" }, "piece": { "oneOf": [{ "$ref": "#/$defs/piece" }, { "type": "null" }] } }, "additionalProperties": false }
      ]
    },
    "structuralFeature": {
      "oneOf": [
        { "type": "object", "required": ["kind", "color", "square"], "properties": { "kind": { "const": "pawn_safe_square" }, "color": { "enum": ["white", "black"] }, "square": { "$ref": "#/$defs/square" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "color", "square"], "properties": { "kind": { "const": "outpost" }, "color": { "enum": ["white", "black"] }, "square": { "$ref": "#/$defs/square" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "color", "file"], "properties": { "kind": { "const": "backward_pawn" }, "color": { "enum": ["white", "black"] }, "file": { "$ref": "#/$defs/file" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "color", "file"], "properties": { "kind": { "const": "isolated_pawn" }, "color": { "enum": ["white", "black"] }, "file": { "$ref": "#/$defs/file" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "color", "file"], "properties": { "kind": { "const": "doubled_pawn" }, "color": { "enum": ["white", "black"] }, "file": { "$ref": "#/$defs/file" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "color", "square"], "properties": { "kind": { "const": "passed_pawn" }, "color": { "enum": ["white", "black"] }, "square": { "$ref": "#/$defs/square" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "file"], "properties": { "kind": { "const": "open_file" }, "file": { "$ref": "#/$defs/file" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "color", "file"], "properties": { "kind": { "const": "half_open_file" }, "color": { "enum": ["white", "black"] }, "file": { "$ref": "#/$defs/file" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "from", "to", "comparison", "count"], "properties": { "kind": { "const": "line_blockers" }, "from": { "$ref": "#/$defs/square" }, "to": { "$ref": "#/$defs/square" }, "comparison": { "enum": ["atLeast", "atMost", "equal"] }, "count": { "type": "integer" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "square", "color", "comparison", "count"], "properties": { "kind": { "const": "direct_attack_count" }, "square": { "$ref": "#/$defs/square" }, "color": { "enum": ["white", "black"] }, "comparison": { "enum": ["atLeast", "atMost", "equal"] }, "count": { "type": "integer" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "color", "role", "scope", "comparison", "count"], "properties": { "kind": { "const": "piece_reach_count" }, "color": { "enum": ["white", "black"] }, "role": { "enum": ["knight", "bishop", "rook", "queen"] }, "scope": { "enum": ["any", "every"] }, "comparison": { "enum": ["atLeast", "atMost", "equal"] }, "count": { "type": "integer" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "id"], "properties": { "kind": { "const": "named_structure" }, "id": { "enum": ["carlsbad", "iqp-white", "iqp-black", "maroczy-bind"] } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "color", "shade"], "properties": { "kind": { "const": "bishop_on_shade" }, "color": { "enum": ["white", "black"] }, "shade": { "enum": ["light", "dark"] } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "color", "basis", "comparison", "count"], "properties": { "kind": { "const": "pawn_count" }, "color": { "enum": ["white", "black"] }, "basis": { "enum": ["count", "difference"] }, "comparison": { "enum": ["atLeast", "atMost", "equal"] }, "count": { "type": "integer" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "color", "form"], "properties": { "kind": { "const": "king_opposition" }, "color": { "enum": ["white", "black"] }, "form": { "enum": ["direct", "distant"] } }, "additionalProperties": false }
      ]
    },
    "structuralExpression": {
      "oneOf": [
        { "type": "object", "required": ["kind", "of"], "properties": { "kind": { "enum": ["all", "any"] }, "of": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/structuralExpression" } } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "of"], "properties": { "kind": { "const": "not" }, "of": { "$ref": "#/$defs/structuralExpression" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "feature"], "properties": { "kind": { "const": "feature" }, "feature": { "$ref": "#/$defs/structuralFeature" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "axis", "of"], "properties": { "kind": { "const": "mirrored" }, "axis": { "enum": ["colors", "files", "both"] }, "of": { "$ref": "#/$defs/structuralExpression" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "quantifier", "over", "feature"], "properties": { "kind": { "const": "quantified" }, "quantifier": { "enum": ["some", "every"] }, "over": { "type": "object", "required": ["files"], "properties": { "files": { "$ref": "#/$defs/fileRange" } }, "additionalProperties": false }, "feature": { "$ref": "#/$defs/fileTemplateFeature" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "quantifier", "over", "feature"], "properties": { "kind": { "const": "quantified" }, "quantifier": { "enum": ["some", "every"] }, "over": { "type": "object", "required": ["squares"], "properties": { "squares": { "$ref": "#/$defs/squareRegion" } }, "additionalProperties": false }, "feature": { "$ref": "#/$defs/squareTemplateFeature" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "square", "piece"], "properties": { "kind": { "const": "pieceOnSquare" }, "square": { "$ref": "#/$defs/square" }, "piece": { "oneOf": [{ "$ref": "#/$defs/piece" }, { "type": "null" }] } }, "additionalProperties": false }
      ]
    },
    "fenPredicate": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "transposeKey" },
            "value": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "square", "piece"],
          "properties": {
            "type": { "const": "pieceOnSquare" },
            "square": { "$ref": "#/$defs/square" },
            "piece": {
              "oneOf": [
                { "$ref": "#/$defs/piece" },
                { "type": "null" }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "mode", "white", "black"],
          "properties": {
            "type": { "const": "pawnStructure" },
            "mode": { "enum": ["contains", "exact"] },
            "white": {
              "type": "array",
              "items": { "$ref": "#/$defs/square" },
              "uniqueItems": true
            },
            "black": {
              "type": "array",
              "items": { "$ref": "#/$defs/square" },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "feature"],
          "properties": {
            "type": { "const": "structuralFeature" },
            "feature": { "$ref": "#/$defs/structuralExpression" }
          },
          "additionalProperties": false
        }
      ]
    },
    "materialBalance": {
      "type": "object",
      "required": ["perspective", "comparison", "value"],
      "properties": {
        "perspective": { "enum": ["white", "black"] },
        "comparison": { "enum": ["atLeast", "atMost", "equal"] },
        "value": { "type": "number" }
      },
      "additionalProperties": false
    },
    "simpleTrigger": {
      "oneOf": [
        {
          "type": "object",
          "required": ["atPly"],
          "properties": {
            "atPly": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["atSpineNode"],
          "properties": {
            "atSpineNode": { "$ref": "#/$defs/id" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["atAuthoredBoundary"],
          "properties": {
            "atAuthoredBoundary": { "const": "crossed" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["fenPredicate"],
          "properties": {
            "fenPredicate": { "$ref": "#/$defs/fenPredicate" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["materialBalance"],
          "properties": {
            "materialBalance": { "$ref": "#/$defs/materialBalance" }
          },
          "additionalProperties": false
        }
      ]
    },
    "timingWindow": {
      "type": "object",
      "required": ["windowOpens", "windowCloses", "luxuryMoveBudget"],
      "properties": {
        "windowOpens": { "$ref": "#/$defs/simpleTrigger" },
        "windowCloses": { "$ref": "#/$defs/simpleTrigger" },
        "luxuryMoveBudget": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "trigger": {
      "oneOf": [
        { "$ref": "#/$defs/simpleTrigger" },
        { "$ref": "#/$defs/timingWindow" }
      ]
    },
    "checkpointInteraction": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "planClassIds"],
          "properties": {
            "type": { "const": "intent_capture" },
            "planClassIds": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/id" },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "prediction" },
            "flipBoard": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    },
    "checkpoint": {
      "type": "object",
      "required": ["id", "trigger"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "trigger": { "$ref": "#/$defs/trigger" },
        "actions": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/nonEmptyString" },
              { "not": { "const": "capture_intent" } }
            ]
          }
        },
        "interaction": { "$ref": "#/$defs/checkpointInteraction" }
      },
      "additionalProperties": false
    },
    "opponentPolicy": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": [
            "theory_strict",
            "human_common",
            "plan_defense",
            "practical_resistance",
            "perfect_tablebase",
            "strong_engine",
            "human_external"
          ]
        },
        "targetElo": { "type": "integer" },
        "temperature": { "type": "number" },
        "topP": { "type": "number", "minimum": 0, "maximum": 1 },
        "stockfishGuardCp": { "type": "integer" },
        "seedMode": { "enum": ["fixed", "per_run", "per_branch"] }
      },
      "additionalProperties": false
    },
    "authoredBoundary": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "spineNodeIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "plyHorizon": { "type": "integer", "minimum": 0 },
        "fenPredicates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fenPredicate" }
        }
      },
      "additionalProperties": false
    },
    "deviationLocation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["spineNodeId"],
          "properties": {
            "spineNodeId": { "$ref": "#/$defs/id" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["fen"],
          "properties": {
            "fen": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        }
      ]
    },
    "deviation": {
      "type": "object",
      "required": ["at", "moveUci", "class"],
      "properties": {
        "at": { "$ref": "#/$defs/deviationLocation" },
        "moveUci": { "$ref": "#/$defs/moveUci" },
        "class": {
          "enum": [
            "required_theory",
            "accepted_alternative",
            "interesting_deviation",
            "concept_violation",
            "tactical_error"
          ]
        },
        "offObjective": { "type": "boolean" },
        "note": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "feedbackClaim": {
      "type": "object",
      "required": ["id", "text", "evidenceTypes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "evidenceTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "author_principle",
              "engine_validated",
              "tablebase_exact",
              "corpus_observed",
              "human_model_predicted",
              "derived_feature",
              "hypothesis"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["reviewStatus"],
      "properties": {
        "reviewStatus": {
          "enum": ["schema_example", "draft", "published"]
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      },
      "additionalProperties": true
    }
  }
}
