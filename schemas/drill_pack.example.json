      "trigger": { "atSpineNode": "najdorf-be3" },
      "interaction": {
        "type": "intent_capture",
        "planClassIds": ["sharp-kingside", "positional-setup"]
      }
    },
    {
      "id": "predict-reply",
      "label": "Predict the reply",
      "trigger": { "atSpineNode": "najdorf-e6" },
      "interaction": {
        "type": "prediction",
        "flipBoard": true
      }
    },
    {
      "id": "timing-window",
      "label": "Critical race resolved",
      "trigger": {
        "atWindow": { "windowId": "najdorf-race", "verdict": "in_time" }
      },
      "actions": ["compare_branches"]
    }
  ],
  "timingWindows": [
    {
      "id": "najdorf-race",
      "label": "Be ready when ...b5 lands",
      "opens": { "onTrigger": { "atSpineNode": "najdorf-f3" } },
      "closes": [
        { "kind": "arrival", "move": { "moveUci": "b7b5" } },
        { "kind": "deadline", "afterLearnerMoves": 2 }
