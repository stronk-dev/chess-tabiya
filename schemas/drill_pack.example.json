      { "kind": "reach_checkpoint", "checkpointId": "timing-window" }
    ]
  },
  "concepts": ["move-order-discipline", "plan-continuity-across-phases"],
  "planClasses": [
    {
      "id": "sharp-kingside",
      "label": "Sharp kingside setup",
      "description": "Choose an aggressive setup and retain its intended move order."
    },
    {
      "id": "positional-setup",
      "label": "Positional setup",
      "description": "Choose a quieter setup before committing more pawns."
    }
  ],
  "spine": [
    {
      "id": "najdorf-be3",
      "moveUci": "c1e3",
      "moveSan": "Be3",
      "annotations": ["Schema-only annotation; requires human review."],
      "children": [
        {
          "id": "najdorf-e6",
          "moveUci": "e7e6",
