{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chess-tabiya:schema:campaign:3",
  "title": "Tabiya Campaign Document",
  "type": "object",
  "required": ["id", "title", "version", "publication", "acts", "economy", "startingModules", "durableRewards"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "version": { "type": "integer", "minimum": 1 },
    "publication": { "$ref": "#/$defs/publication" },
    "acts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/act1" },
        { "$ref": "#/$defs/act2" },
        { "$ref": "#/$defs/act3" }
      ],
      "items": false
    },
    "economy": { "$ref": "#/$defs/economy" },
    "startingModules": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/unlockableModule" }
    },
    "durableRewards": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/durableRewardGrant" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "unlockableModule": {
      "enum": [
        "sight_on_request",
        "blunder_prevention",
        "threat_radar",
        "postcommit_nudge",
        "structure_nudge",
        "theory_breadcrumb",
        "guided_hint",
        "compare_coach",
        "review_map",
        "full_inspector"
      ]
    },
    "publication": {
      "oneOf": [
        {
          "type": "object",
          "required": ["channel"],
          "properties": { "channel": { "const": "community" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["channel", "curriculum"],
          "properties": {
            "channel": { "const": "official" },
            "curriculum": { "$ref": "#/$defs/curriculum" }
          },
          "additionalProperties": false
        }
      ]
    },
    "nodeIdList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "curriculum": {
      "type": "object",
      "required": ["targetLearner", "expectedEnvelope", "phaseCoverage", "formCoverage", "theoryProvenance", "dependencyAvailability", "reviewReceipt"],
      "properties": {
        "targetLearner": {
          "type": "object",
          "required": ["bracketId", "prerequisites"],
          "properties": {
            "bracketId": { "$ref": "#/$defs/nonEmptyString" },
            "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
          },
          "additionalProperties": false
        },
        "expectedEnvelope": {
          "type": "object",
          "required": ["minimumMinutes", "maximumMinutes"],
          "properties": {
            "minimumMinutes": { "type": "integer", "minimum": 1 },
            "maximumMinutes": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "phaseCoverage": {
          "type": "object",
          "required": ["opening", "middlegame", "endgame"],
          "properties": {
            "opening": { "$ref": "#/$defs/nodeIdList" },
            "middlegame": { "$ref": "#/$defs/nodeIdList" },
            "endgame": { "$ref": "#/$defs/nodeIdList" }
          },
          "additionalProperties": false
        },
        "formCoverage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["encounterKind", "nodeIds"],
            "properties": {
              "encounterKind": { "enum": ["pack", "boss_game"] },
              "nodeIds": { "$ref": "#/$defs/nodeIdList" }
            },
            "additionalProperties": false
          }
        },
        "theoryProvenance": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["nodeId", "passage", "evidenceRefs"],
            "properties": {
              "nodeId": { "$ref": "#/$defs/id" },
              "passage": { "$ref": "#/$defs/theoryPassageRef" },
              "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
            },
            "additionalProperties": false
          }
        },
        "dependencyAvailability": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["requirement", "requiredAt", "unavailableAction", "sourceAvailable"],
            "properties": {
              "requirement": { "$ref": "#/$defs/nonEmptyString" },
              "requiredAt": { "$ref": "#/$defs/nodeIdList" },
              "unavailableAction": { "enum": ["refuse_start", "honest_degradation"] },
              "fallbackOperation": { "$ref": "#/$defs/nonEmptyString" },
              "sourceAvailable": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "reviewReceipt": {
          "type": "object",
          "required": ["authority", "documentDigest", "reviewedAt"],
          "properties": {
            "authority": { "const": "owner_human_chess_review" },
            "documentDigest": { "$ref": "#/$defs/digest" },
            "reviewedAt": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "theoryPassageRef": {
      "type": "object",
      "required": ["bundleId", "passageId"],
      "properties": {
        "bundleId": { "$ref": "#/$defs/nonEmptyString" },
        "passageId": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "packEncounter": {
      "type": "object",
      "required": ["kind", "packId"],
      "properties": {
        "kind": { "const": "pack" },
        "packId": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "botProfileReference": {
      "type": "object",
      "required": ["id", "family", "band", "version", "digest", "model", "sampler", "orderedLayers"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "family": { "$ref": "#/$defs/nonEmptyString" },
        "band": { "type": "integer" },
        "version": { "const": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "model": {
          "type": "object",
          "required": ["id", "version"],
          "properties": {
            "id": { "$ref": "#/$defs/nonEmptyString" },
            "version": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        "sampler": {
          "type": "object",
          "required": ["temperature", "topP", "requestedWidth", "returnedMassFloor"],
          "properties": {
            "temperature": { "type": "number" },
            "topP": { "type": "number" },
            "requestedWidth": { "type": "integer" },
            "returnedMassFloor": { "type": "number" }
          },
          "additionalProperties": false
        },
        "orderedLayers": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
      },
      "additionalProperties": false
    },
    "bossGameEncounter": {
      "type": "object",
      "required": ["kind", "start", "opponent", "rating", "briefingRef"],
      "properties": {
        "kind": { "const": "boss_game" },
        "start": {
          "type": "object",
          "required": ["fen", "learnerSide"],
          "properties": {
            "fen": { "$ref": "#/$defs/nonEmptyString" },
            "learnerSide": { "enum": ["white", "black"] }
          },
          "additionalProperties": false
        },
        "opponent": {
          "type": "object",
          "required": ["profile"],
          "properties": {
            "profile": { "$ref": "#/$defs/botProfileReference" },
            "calibration": {
              "type": "object",
              "required": ["profileDigest", "calibrationId", "timeControlScope", "harnessReceipt"],
              "properties": {
                "profileDigest": { "$ref": "#/$defs/digest" },
                "calibrationId": { "$ref": "#/$defs/nonEmptyString" },
                "timeControlScope": { "$ref": "#/$defs/nonEmptyString" },
                "harnessReceipt": { "$ref": "#/$defs/nonEmptyString" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "rating": { "enum": ["rated_when_clean", "unrated"] },
        "briefingRef": {
          "type": "object",
          "required": ["kind", "packId"],
          "properties": {
            "kind": { "const": "pack_start" },
            "packId": { "$ref": "#/$defs/id" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "encounter": {
      "oneOf": [
        { "$ref": "#/$defs/packEncounter" },
        { "$ref": "#/$defs/bossGameEncounter" }
      ]
    },
    "runReward": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "moduleId"],
          "properties": {
            "kind": { "const": "module_unlock" },
            "moduleId": { "$ref": "#/$defs/unlockableModule" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "bundleId", "passageId"],
          "properties": {
            "kind": { "const": "theory_unlock" },
            "bundleId": { "$ref": "#/$defs/nonEmptyString" },
            "passageId": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "resourceId", "amount"],
          "properties": {
            "kind": { "const": "resource_grant" },
            "resourceId": { "const": "campaign_rewind_charge" },
            "amount": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "runRewardRef": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "moduleId"],
          "properties": {
            "kind": { "const": "module_unlock" },
            "moduleId": { "$ref": "#/$defs/unlockableModule" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "bundleId", "passageId"],
          "properties": {
            "kind": { "const": "theory_unlock" },
            "bundleId": { "$ref": "#/$defs/nonEmptyString" },
            "passageId": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "resourceId"],
          "properties": {
            "kind": { "const": "resource_grant" },
            "resourceId": { "const": "campaign_rewind_charge" }
          },
          "additionalProperties": false
        }
      ]
    },
    "durableReward": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "campaignId", "campaignVersion"],
          "properties": {
            "kind": { "enum": ["completion_mark", "prestige_mark"] },
            "campaignId": { "$ref": "#/$defs/id" },
            "campaignVersion": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "target"],
          "properties": {
            "kind": { "const": "cosmetic_unlock" },
            "target": {
              "type": "object",
              "required": ["kind", "id"],
              "properties": {
                "kind": { "enum": ["app_theme", "board_theme", "piece_set"] },
                "id": { "$ref": "#/$defs/nonEmptyString" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "durableRewardGrant": {
      "type": "object",
      "required": ["when", "reward"],
      "properties": {
        "when": { "enum": ["completed", "prestige"] },
        "reward": { "$ref": "#/$defs/durableReward" }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "encounter"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "encounter": { "$ref": "#/$defs/encounter" },
        "suppress": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/unlockableModule" }
        },
        "reward": { "$ref": "#/$defs/runReward" },
        "consumes": {
          "type": "array",
          "items": { "$ref": "#/$defs/runRewardRef" }
        },
        "boss": { "const": true }
      },
      "additionalProperties": false
    },
    "layer": {
      "type": "object",
      "required": ["choices"],
      "properties": {
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/layer" }
    },
    "act1": {
      "type": "object",
      "required": ["id", "layers"],
      "properties": { "id": { "const": "act1" }, "layers": { "$ref": "#/$defs/layers" } },
      "additionalProperties": false
    },
    "act2": {
      "type": "object",
      "required": ["id", "layers"],
      "properties": { "id": { "const": "act2" }, "layers": { "$ref": "#/$defs/layers" } },
      "additionalProperties": false
    },
    "act3": {
      "type": "object",
      "required": ["id", "layers"],
      "properties": { "id": { "const": "act3" }, "layers": { "$ref": "#/$defs/layers" } },
      "additionalProperties": false
    },
    "economy": {
      "type": "object",
      "required": ["startingCharges", "actGrants", "validation"],
      "properties": {
        "startingCharges": { "type": "integer", "minimum": 0 },
        "actGrants": {
          "type": "object",
          "required": ["act1", "act2", "act3"],
          "properties": {
            "act1": { "type": "integer", "minimum": 0 },
            "act2": { "type": "integer", "minimum": 0 },
            "act3": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "validation": { "const": "candidate" }
      },
      "additionalProperties": false
    }
  }
}
