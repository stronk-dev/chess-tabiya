          "op": "add",
          "path": "/$defs/capabilityVersion",
          "value": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "integer"
                  },
                  "value": {
